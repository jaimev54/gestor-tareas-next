# Copia este archivo como .env.local y rellena los valores
# (Supabase → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública de la app (para los enlaces de los correos de Supabase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cuenta demo (solo servidor, NUNCA con prefijo NEXT_PUBLIC_).
# Contraseña del usuario demo@example.com creado en Supabase → Authentication → Users.
# Si no se define, el botón "Probar la demo" no aparece.
DEMO_PASSWORD=
